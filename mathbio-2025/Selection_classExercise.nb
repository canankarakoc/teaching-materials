          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "s"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"s", " ", 
              RowBox[{"p", "[", 
               RowBox[{"t", "-", "1"}], "]"}]}]}], ")"}]}]}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"recursive", " ", "definition"}], "*)"}], 
       RowBox[{"data", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"p", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "maxGen"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"generate", " ", "table"}], "*)"}], 
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListPlot", "[", 
           RowBox[{"data", ",", 
            RowBox[{"Joined", "->", "True"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Generation\>\"", ",", "\"\<Frequency of Allele A\>\""}], 
              "}"}]}], ",", 
            RowBox[{
            "PlotLabel", "->", 
             "\"\<Change in Allele A Frequency Over Time (Haploid \
Selection)\>\""}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{"data", ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Generation\>\"", ",", "\"\<p\>\""}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"Frame", "->", "All"}]}], "]"}]}], "}"}], "]"}]}]}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p0", ",", "0.01", ",", "\"\<Initial frequency (p\:2080)\>\""}], "}"}],
       ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "0.02", ",", "\"\<Selection coefficient (s)\>\""}], 
       "}"}], ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"maxGen", ",", "50", ",", "\"\<Number of generations\>\""}], 
       "}"}], ",", "10", ",", "500", ",", "10"}], "}"}]}], "]"}], 
