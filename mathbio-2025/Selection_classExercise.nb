Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "data"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "0", "]"}], "=", "p0"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"p", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"p", "[", "t", "]"}], "=", 
